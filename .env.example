# Copy to .env and fill in. Every .env* file except this one is gitignored —
# never commit real values. See README.md > Configuration.
#
# Every key here is OPTIONAL. Without them the app still runs; it simply
# degrades to the features it can serve. Missing GENIUS_ACCESS_TOKEN, for
# example, means no album art — lyrics and search work exactly as before.

# Public origin of this deployment, no trailing slash — e.g.
# https://lyrics.example.com  (ARCHITECTURE.md D-051)
# Only social crawlers need it, and they need it absolutely: Open Graph requires
# og:image to be a full URL and silently drops a relative one. Without this,
# shared track links preview without their lyric card. Harmless to omit locally.
SITE_URL=

# Genius API — artwork fallback and the YouTube playback id (OD-005, D-111)
# Create a free API client at https://genius.com/api-clients, then copy the
# "Client Access Token" (NOT the client id or secret). No OAuth flow is needed
# for public song data. Without it there is no playback and no artwork
# fallback; Spotify art below still works on its own.
GENIUS_ACCESS_TOKEN=

# Spotify Web API — canonical album art (ARCHITECTURE.md D-111)
# Create an app at https://developer.spotify.com/dashboard and copy BOTH the
# Client ID and the Client Secret. Server-side client-credentials flow only:
# no listener ever logs in, so neither the Premium requirement nor the
# Development-mode 25-user cap applies. If the secret has ever been displayed
# anywhere outside this file — a screenshot, a chat, a terminal — rotate it on
# the dashboard before using it here.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# DeepSeek — the synthesis for the insights drawer (ARCHITECTURE.md OD-003)
# PRIMARY PROVIDER. Key from https://platform.deepseek.com
# Without this AND without GEMINI_API_KEY below, the "Discover the Story"
# button never appears; everything else works unchanged.
#
# Metered, not free-tiered, which is the point: an insight costs about
# $0.0006, so $10 covers roughly 16,000 of them. Gemini's free tier caps at
# 20 a day, which is what made the drawer undeployable (OD-021).
DEEPSEEK_API_KEY=

# Omit for the default (deepseek-v4-flash). deepseek-v4-pro is also available
# and is NOT worth it here: measured 3x slower for no gain on any output gate.
# DEEPSEEK_MODEL=deepseek-v4-flash

# Gemini — the FALLBACK provider, used only when DeepSeek returns nothing
# (D-050). Key from https://aistudio.google.com/apikey
# Entirely optional. Without it a DeepSeek outage means no drawer that day;
# with it the two fail independently.
GEMINI_API_KEY=

# Model names change often, and Google retires them for new keys without
# notice — 2.5-flash stopped being served mid-2026. Omit for the default
# (gemini-3.5-flash); override here when a newer or cheaper one lands.
# GEMINI_MODEL=gemini-3.5-flash

# Tavily — web grounding for the source gallery (OD-004)
# Key from https://app.tavily.com
# OPTIONAL, but consequential: without grounding the synthesis is written from
# the lyrics alone and NO QUOTE is shown at all, because an unsourced quote
# attributed to a real artist would be a fabrication. See D-021.
TAVILY_API_KEY=

# Upstash Redis — the production cache (ARCHITECTURE.md OD-001, D-024)
# Create a database at https://console.upstash.com and copy the REST url/token.
#
# STRONGLY RECOMMENDED FOR ANY DEPLOYMENT. Without these the app falls back to
# an in-memory cache that is per-process: it does not survive a restart and is
# not shared between serverless instances, which makes the sub-500ms target in
# PRD §5 unreachable. The server logs a warning at startup when it falls back.
# Listen-party rooms (D-115) live in this same store — on the in-memory
# fallback a server restart ends every party, and serverless instances would
# not even agree a room exists. Effectively REQUIRED for parties in production.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
