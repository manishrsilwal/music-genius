# Copy to .env.local and fill in. .env.local is gitignored — never commit real values.
#
# Every key here is OPTIONAL. Without them the app still runs; it simply
# degrades to the features it can serve. Missing GENIUS_ACCESS_TOKEN, for
# example, means no album art — lyrics and search work exactly as before.

# Genius API — album art and metadata (ARCHITECTURE.md OD-005)
# Create a free API client at https://genius.com/api-clients, then copy the
# "Client Access Token" (NOT the client id or secret). No OAuth flow is needed
# for public song data.
GENIUS_ACCESS_TOKEN=

# Gemini — the synthesis for the insights drawer (ARCHITECTURE.md OD-003)
# Key from https://aistudio.google.com/apikey
# Without this the "Discover the Story" button never appears; everything else
# works unchanged.
GEMINI_API_KEY=

# Model names change often, and Google retires them for new keys without
# notice — 2.5-flash stopped being served mid-2026. Omit for the default
# (gemini-3.5-flash); override here when a newer or cheaper one lands.
# GEMINI_MODEL=gemini-3.5-flash

# Tavily — web grounding for the source gallery (OD-004)
# Key from https://app.tavily.com
# OPTIONAL, but consequential: without grounding the synthesis is written from
# the lyrics alone and NO QUOTE is shown at all, because an unsourced quote
# attributed to a real artist would be a fabrication. See D-021.
TAVILY_API_KEY=

# Upstash Redis — the production cache (ARCHITECTURE.md OD-001, D-024)
# Create a database at https://console.upstash.com and copy the REST url/token.
#
# STRONGLY RECOMMENDED FOR ANY DEPLOYMENT. Without these the app falls back to
# an in-memory cache that is per-process: it does not survive a restart and is
# not shared between serverless instances, which makes the sub-500ms target in
# PRD §5 unreachable. The server logs a warning at startup when it falls back.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
